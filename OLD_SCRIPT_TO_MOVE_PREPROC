%% 4) ROI MASKS + LAYER GROWTH

% 4.1) Using FSL: draw anatomical ROI masks
% save them as [region_name]-mask.nii at /processed/{sub}/masks

% use the following color scheme
% 1 = Grey Matter-CSF border
% 2 = Grey-White matter
% 3 = closing boundaries

% 4.2) Grow layers
% run this script section to generate layered masks

NLAYERS = 10;

if first_run

% finds mask files in dir
MASKS = get_masks(MASKDIR,'masks');

% saves commands to text file
filename = sprintf('%s/4_generate-%d-layers.sh',SCRIPTS,NLAYERS);
fid = fopen(filename,'w');
fprintf(fid,'#!/bin/bash\n\n# Generating %d Layers for %s\n\n',NLAYERS,sub);

for i = 1:length(MASKS)  
    % command to grow layers on input masks
    cmd = sprintf('%s/LN_GROW_LAYERS -rim %s/%s -N %d',LAYNII,MASKDIR,MASKS(i),NLAYERS);
    fprintf(fid,'%s\n\n',cmd);
end

fclose(fid);

% source the file to grow layers
cd(ANATDIR)
system(sprintf('source %s',filename))

end

% updates mask list with layered versions only
MASKS = get_masks(MASKDIR,'layers');

%% 5) COREGISTRATION

matlabbatch = coregistration(all_runs,BIDS,ANATDIR,FUNCDIR,anat_img,run_masks,MASKDIR,SPMDIR);

cd(SCRIPTS)
save 5_coregistration matlabbatch

cd(FUNCDIR)
spm_jobman('run',matlabbatch) % execute the batch
clear matlabbatch

disp("COREGISTRATION COMPLETE")

%% 6) SEGMENTATION

matlabbatch = segmentation(all_runs,ANATDIR,SPMDIR);

cd(SCRIPTS)
save 6_segmentation matlabbatch

cd(ANATDIR)
spm_jobman('run',matlabbatch) % execute the batch
clear matlabbatch

disp("SEGMENTATION COMPLETE")

%% 7) NORMALIZATION

matlabbatch = normalization(all_runs,ANATDIR,FUNCDIR,run_masks,MASKDIR,SPMDIR);

cd(SCRIPTS)
save 7_normalization matlabbatch

cd(FUNCDIR)
spm_jobman('run',matlabbatch) % execute the batch
clear matlabbatch

disp("NORMALIZATION COMPLETE")

%% 8) SMOOTHING

matlabbatch = smoothing(all_runs,FUNCDIR,SPMDIR);

cd(SCRIPTS)
save 8_smoothing matlabbatch
cd(FUNCDIR)

spm_jobman('run',matlabbatch) % execute the batch
clear matlabbatch

disp("SMOOTHING COMPLETE")
