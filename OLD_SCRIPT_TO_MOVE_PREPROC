% 7T fMRI - Preprocessing Script
% By domenico

%% 0.1) SCAN INFO AND METADATA

sub = 'U103';
first_run = true; % if first time running script
run_masks = false; % set to TRUE if mask analysis ready to run

%% 0.2) FILE DIRECTORY SETUP

% baseline directories
BASEDIR = '/data/lavlab/layer-7t-predictive-coding';
DATADIR = sprintf('%s/data',BASEDIR);

% software + code
CODEDIR = sprintf('%s/code',BASEDIR);
addpath(CODEDIR);
SPMDIR = '/home/cic/mardom/Documents/APPS/spm/';
addpath(SPMDIR);
LAYNII = '~/Documents/APPS/LayNii/';

% raw data directories for sub
DICOM = sprintf('%s/raw/dicom/%s',DATADIR,sub);
MINC = sprintf('%s/raw/minc/%s',DATADIR,sub);
BIDS = sprintf('%s/raw/bids',DATADIR);
SUBBIDS = sprintf('%s/sub-%s',BIDS,sub);

% processed data directories for sub
if first_run
    mkdir(sprintf('%s/processed/%s/',DATADIR,sub));
end
FUNCDIR = sprintf('%s/processed/%s/func',DATADIR,sub);
ANATDIR = sprintf('%s/processed/%s/anat',DATADIR,sub);
MASKDIR = sprintf('%s/processed/%s/masks',DATADIR,sub);
SCRIPTS = sprintf('%s/processed/%s/scripts',DATADIR,sub);

% creates all required directories

if first_run
    mkdir(MINC); % dicom given / bids created later
    mkdir(FUNCDIR); mkdir(ANATDIR); mkdir(MASKDIR); mkdir(SCRIPTS);
end

%% 1.1) CONVERTING DICOM TO NIFTI

cmd = convert_dicom(sub,DICOM,CODEDIR,BIDS); % retrieves dcm2bids command

% saves command to text file
filename = sprintf('%s/1_dicom-to-bids.sh',SCRIPTS);
fid = fopen(filename,'w');
fprintf(fid,'%s',cmd);
fclose(fid);

% running the process
cd(SUBBIDS)
system(sprintf('source %s',filename))

disp("DICOM CONVERSION COMPLETE")

%% 1.2) IDENTIFYING TARGET SCANS

% the script is looking for one T1w anat
% also needs VASO + BOLD functional scans

[bold_runs, vaso_runs, anat_img] = get_images(sub,SUBBIDS);

all_runs = [bold_runs,vaso_runs];

%% 1.3) DEFACING SCANS [TO WRITE]

% only need to do the T1w
cmd = deface_scans(sub,SUBBIDS);


%% 2) MOTION CORRECTION

matlabbatch = motion_correction(all_runs,SUBBIDS,SPMDIR);

cd(SCRIPTS) % saves job to dir
save 2_motion-correction matlabbatch

cd(FUNCDIR) % saves output to func dir
spm_jobman('run',matlabbatch) % execute the batch
clear matlabbatch % clear matlabbatch

disp("MOTION CORRECTION COMPLETED")

%% 3) CORRECT T2* DEPENDENCY

% this step decontaminates the vaso runs using bold signal
% basically complicated, look at the blog posts

command = bold_correction(sub,FUNCDIR,bold_runs,vaso_runs,TR);

% saves commands to text file
filename = sprintf('%s/3_bold-correction.sh',SCRIPTS);
fid = fopen(filename,'w');
fprintf(fid,'%s',command);
fclose(fid);

cd(FUNCDIR)
system(sprintf('source %s',filename))

disp("BOLD CORRECTION COMPLETE")

